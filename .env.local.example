# Optional. Get a free key at https://portal.cdp.coinbase.com to use
# Coinbase's own RPC for Base mainnet instead of the public endpoint, and to
# unlock paymaster-sponsored transactions in OnchainKit. The app runs fine
# without this set — it falls back to a public Base RPC.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Optional. The deployed origin (no trailing slash), used to resolve
# absolute URLs for the OG image and social previews. Falls back to
# http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=
