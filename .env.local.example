# Production origin. Set this on Vercel to the owned domain.
# Local dev can leave it unset (metadata falls back to localhost).
NEXT_PUBLIC_SITE_URL=https://novafolio.app

# Free Alchemy key — required for automatic token detection across chains.
# Sign up at https://dashboard.alchemy.com (free plan, 30M compute units/month).
# Create one app and copy the API key. Server-only; do not prefix with NEXT_PUBLIC_.
# Without it, Novafolio still runs and shows major tokens via public RPCs.
ALCHEMY_API_KEY=

# Optional. Free WalletConnect / Reown project id so mobile wallets can connect.
# https://cloud.reown.com — leave unset and Coinbase, MetaMask, and Rabby still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Free Coinbase Developer Platform key for a faster Base RPC.
# https://portal.cdp.coinbase.com — the app uses public RPCs when this is unset.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Optional. CoinGecko demo key if the unauthenticated price endpoint rate-limits.
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# Set to "pro" only if the key is a paid CoinGecko Pro key.
COINGECKO_PLAN=

# Optional contact address on /support. Leave unset rather than inventing one.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional. Plausible domain, e.g. novafolio.app. Unset means no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Cloud sync, waitlist, and daily jobs (all optional for the free launch) ---
# On Vercel these features stay off until DATABASE_URL is set. The file store
# at ./.data is for local development only.

# Required before sign-in works in production. `openssl rand -base64 32`
SESSION_SECRET=

# Postgres connection string (Neon has a free tier). Apply migrations/001_init.sql
# and migrations/002_subscriptions.sql first.
DATABASE_URL=

# Local file store directory. Ignored on Vercel.
DATA_DIR=

# Protects /api/cron/*. Vercel sends this as a Bearer token. `openssl rand -base64 32`
# Crons are daily (Hobby plan). They no-op when DATABASE_URL is unset.
CRON_SECRET=

# --- Do not set these for the free launch ---
# Zerion's free tier is 2,000 requests/day and is meant for prototypes.
# Alchemy is the launch indexer. Zerion is only used for portfolio data when
# ALCHEMY_API_KEY is unset and this key is set. PnL and activity need it.
ZERION_API_KEY=

# Comma-separated addresses that always get Pro. In production, nobody is Pro
# unless they are listed here or have a live Stripe subscription.
PRO_ADDRESSES=

# Stripe. Leave blank. Pro is not for sale until all three are set AND
# DATABASE_URL is set.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
