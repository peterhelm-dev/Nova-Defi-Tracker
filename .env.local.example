# Optional. Get a free key at https://portal.cdp.coinbase.com to use
# Coinbase's own RPC for Base mainnet instead of the public endpoint, and to
# unlock paymaster-sponsored transactions in OnchainKit. The app runs fine
# without this set — it falls back to a public Base RPC.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Optional. The deployed origin (no trailing slash), used to resolve
# absolute URLs for the OG image and social previews. Falls back to
# http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# Required in production. Secret used to sign (HMAC) the stateless session
# cookie issued after Sign-In With Ethereum. Use a long random string. In
# development a built-in insecure default is used if this is unset.
SESSION_SECRET=

# Optional. Directory for the default file-backed server store (net-worth
# history, tracked positions, and the Pro waitlist). Defaults to ./.data.
DATA_DIR=

# Optional. Postgres connection string. When set, the server store uses
# Postgres (production-grade, multi-instance safe) instead of the file store.
# Apply migrations/001_init.sql to the database first.
DATABASE_URL=

# Required to run the scheduled daily net-worth snapshot job
# (/api/cron/snapshot). The job refuses to run if this is unset. Vercel Cron
# sends it automatically as a Bearer token when configured (see vercel.json).
CRON_SECRET=
